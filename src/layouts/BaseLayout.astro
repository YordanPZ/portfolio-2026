---
import '~/styles/global.css';
import { site } from '~/data/site';

interface Props {
  title?: string;
}

const { title = site.title } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={site.descriptionEn} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- CV URL config -->
    <script is:inline define:vars={{ cvUrl: site.cvUrl }}>
      window.CV_URL = cvUrl;
    </script>

    <!-- Pre-render theme to avoid flash -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('yp-theme');
          var t = stored || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = t;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <slot />

    <!-- Aviso de visita (analítica propia). ?me=1 marca este navegador como tuyo y deja de notificar. -->
    <script is:inline>
      (function () {
        try {
          var p = new URLSearchParams(location.search);
          if (p.get('me') === '1') localStorage.setItem('yp-owner', '1');
          if (sessionStorage.getItem('yp-hit') === '1') return;
          sessionStorage.setItem('yp-hit', '1');
          var owner = localStorage.getItem('yp-owner') === '1';
          fetch('/api/hit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              page: location.pathname,
              ref: document.referrer || 'directo',
              lang: navigator.language || '',
              owner: owner,
            }),
            keepalive: true,
          }).catch(function () {});
        } catch (e) {}
      })();
    </script>

    <script>
      import '~/scripts/lang-toggle';
      import '~/scripts/theme-toggle';
      import '~/scripts/scroll-reveal';
      import '~/scripts/cv-link';
    </script>
  </body>
</html>
