---
import SectionHead from './SectionHead.astro';
import { timeline, education } from '~/data/experience';
---
<section class="block" id="experience">
  <div class="wrap">
    <SectionHead
      num="02"
      labelEs="Experiencia"
      labelEn="Experience"
      titleEs="Una línea, cuatro paradas."
      titleEn="One line, four stops."
    />

    <div class="timeline">
      {timeline.map((entry) => (
        <div class="tl-row">
          <div class="tl-when">
            <span>
              {entry.yearRange.includes('hoy') ? (
                <>
                  {entry.yearRange.replace('hoy', '')}
                  <span data-lang-es lang="es">hoy</span><span data-lang-en lang="en">now</span>
                </>
              ) : (
                entry.yearRange
              )}
            </span>
            {entry.isCurrent ? (
              <span class="now"><span data-lang-es lang="es">Actualmente</span><span data-lang-en lang="en">Current</span></span>
            ) : (
              <span><span data-lang-es lang="es">{entry.durationEs}</span><span data-lang-en lang="en">{entry.durationEn}</span></span>
            )}
          </div>
          <div class="tl-role serif-i">
            <span data-lang-es lang="es">{entry.roleEs}</span><span data-lang-en lang="en">{entry.roleEn}</span>
            <span class="at">
              {entry.company}
              {(entry.whereEs || entry.whereEn) && (
                <span class="where">
                  <span data-lang-es lang="es">{entry.whereEs}</span><span data-lang-en lang="en">{entry.whereEn}</span>
                </span>
              )}
            </span>
          </div>
          <ul class="tl-bullets">
            {entry.bullets.map((b) => (
              <>
                <li data-lang-es>{b.es}</li>
                <li data-lang-en>{b.en}</li>
              </>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="education">
      <div class="section-num">
        <span class="bar" aria-hidden="true"></span>
        <span><span data-lang-es lang="es">Formación</span><span data-lang-en lang="en">Education</span></span>
      </div>
      <div class="education-grid">
        {education.map((edu) => (
          <div>
            <div class="edu-year">{edu.yearRange}</div>
            <div class="edu-title serif-i">
              <span data-lang-es lang="es">{edu.titleEs}</span><span data-lang-en lang="en">{edu.titleEn}</span>
            </div>
            <div class="edu-inst">{edu.institution}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  section.block {
    padding: clamp(80px, 10vw, 150px) 0;
    border-bottom: 1px solid var(--color-line);
  }
  .timeline {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-line);
  }
  .tl-row {
    display: grid;
    grid-template-columns: 220px 1fr 1fr;
    gap: var(--gutter);
    padding: 32px 0;
    border-bottom: 1px solid var(--color-line);
    align-items: start;
    transition: background-color .3s ease, border-color .3s ease, transform .25s ease;
  }
  .tl-row:hover {
    background: color-mix(in oklab, var(--color-ink) 3%, transparent);
  }
  .tl-when {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
    letter-spacing: .04em;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tl-when .now {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-ink);
    font-size: 11px;
  }
  .tl-when .now::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: var(--color-ok);
  }
  .tl-role {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.05;
    color: var(--color-ink);
  }
  .tl-role .at {
    display: block;
    font-family: var(--font-sans);
    font-style: normal;
    font-size: 13px;
    letter-spacing: .02em;
    color: var(--color-ink-2);
    margin-top: 8px;
  }
  .tl-role .at .where {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-left: 8px;
  }
  .tl-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-ink-2);
  }
  .tl-bullets li {
    padding-left: 16px;
    position: relative;
    margin-bottom: 6px;
  }
  .tl-bullets li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-muted);
  }
  @media (max-width: 900px) {
    .tl-row { grid-template-columns: 1fr; gap: 16px; }
  }

  .education {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--gutter);
    margin-top: 72px;
  }
  .education .section-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--color-muted);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .education .section-num .bar {
    width: 32px;
    height: 1px;
    background: var(--color-ink);
    display: inline-block;
  }
  .education-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px var(--gutter);
  }
  .edu-year {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 6px;
  }
  .edu-title {
    font-size: 22px;
    line-height: 1.15;
  }
  .edu-inst {
    font-size: 14px;
    color: var(--color-ink-2);
    margin-top: 4px;
  }
  @media (max-width: 720px) {
    .education { grid-template-columns: 1fr; }
    .education-grid { grid-template-columns: 1fr; }
  }
</style>
