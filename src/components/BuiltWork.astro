---
import SectionHead from './SectionHead.astro';
import { builtItems } from '~/data/built';
---
<section class="block" id="built">
  <div class="wrap">
    <SectionHead
      num="03"
      labelEs="Lo construido"
      labelEn="What I've built"
      titleEs="Sistemas reales, detrás de un login."
      titleEn="Real systems, behind a login."
    />

    <p class="built-note mono">
      <span data-lang-es>Casi todo lo que envío vive en orgs privadas. Aquí va por tipo de sistema — sin nombres de cliente, con la sustancia técnica intacta.</span>
      <span data-lang-en>Almost everything I ship lives in private orgs. Here it goes by type of system — no client names, technical substance intact.</span>
    </p>

    <div class="built-list">
      {builtItems.map((item) => (
        <article class="built-row">
          <div class="built-idx">{item.idx}</div>
          <div class="built-name serif-i">
            <span data-lang-es>{item.nameEs}</span><span data-lang-en>{item.nameEn}</span>
            <span class="ctx">
              <span data-lang-es>{item.ctxEs}</span><span data-lang-en>{item.ctxEn}</span>
            </span>
          </div>
          <div class="built-desc">
            <span data-lang-es-block>{item.descEs}</span>
            <span data-lang-en-block>{item.descEn}</span>
          </div>
          <div class="built-stack">
            {item.stack.map((s) => <span>{s}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  section.block {
    padding: clamp(80px, 10vw, 150px) 0;
    border-bottom: 1px solid var(--color-line);
  }
  .built-note {
    color: var(--color-muted);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    max-width: 64ch;
    margin: 0 0 32px;
  }
  .built-list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-line);
  }
  .built-row {
    display: grid;
    grid-template-columns: 90px 1fr 1.4fr 200px;
    gap: var(--gutter);
    padding: 36px 0;
    border-bottom: 1px solid var(--color-line);
    align-items: start;
    transition: background-color .3s ease, padding .2s, border-color .3s ease, transform .25s ease;
  }
  .built-row:hover {
    background: color-mix(in oklab, var(--color-ink) 3%, transparent);
  }
  .built-row:hover .built-name { letter-spacing: -0.02em; }
  .built-idx {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-muted);
    letter-spacing: .08em;
    padding-top: 8px;
  }
  .built-name {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(26px, 2.8vw, 40px);
    line-height: 1.0;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    transition: letter-spacing .15s;
  }
  .built-name .ctx {
    display: block;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-top: 10px;
  }
  .built-desc {
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--color-ink-2);
    max-width: 52ch;
    padding-top: 4px;
  }
  .built-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 6px;
    align-content: start;
  }
  .built-stack span {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .04em;
    color: var(--color-muted);
    border: 1px solid var(--color-line-2);
    border-radius: 99px;
    padding: 3px 8px;
  }
  @media (max-width: 1080px) {
    .built-row { grid-template-columns: 60px 1fr; }
    .built-desc, .built-stack { grid-column: 2; }
  }
  @media (max-width: 600px) {
    .built-row { grid-template-columns: 1fr; gap: 14px; }
    .built-desc, .built-stack { grid-column: 1; }
    .built-idx { padding-top: 0; }
  }
</style>
