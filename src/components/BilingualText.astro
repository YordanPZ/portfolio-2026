---
interface Props {
  es: string;
  en: string;
  block?: boolean;
  html?: boolean;
}

const { es, en, block = false, html = false } = Astro.props;
---
{block ? (
  html ? (
    <>
      <span data-lang-es-block lang="es" set:html={es} />
      <span data-lang-en-block lang="en" set:html={en} />
    </>
  ) : (
    <>
      <span data-lang-es-block lang="es">{es}</span>
      <span data-lang-en-block lang="en">{en}</span>
    </>
  )
) : (
  html ? (
    <>
      <span data-lang-es lang="es" set:html={es} />
      <span data-lang-en lang="en" set:html={en} />
    </>
  ) : (
    <>
      <span data-lang-es lang="es">{es}</span>
      <span data-lang-en lang="en">{en}</span>
    </>
  )
)}
